# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SellwildDemo' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Pull the iOS SDK pod and the RN bridge pod from the worktree. We
  # pin to local paths because (1) we want to link against whatever
  # we're iterating on locally, not the published trunk version, and
  # (2) demo-app's package.json doesn't declare @sellwild/react-native-sdk
  # as an npm dep (Metro resolves it via metro.config.js for JS), so
  # use_native_modules! has nothing to autolink.
  # :modular_headers is required so the SDK builds as a Clang module and
  # `import SellwildSDK` resolves from the Swift bridge target. Without
  # this, pods are built as plain static libs with no module map.
  # Both podspecs use paths relative to their own location, so :path
  # points at the directory that contains the .podspec file. The
  # SDK podspec was historically written with repo-root-relative
  # paths (for pod trunk push from repo root); we've fixed it to
  # use podspec-local paths instead, and now invoke trunk pushes
  # from the ios/ directory.
  pod 'SellwildSDK',    :path => '../../../',                 :modular_headers => true
  pod 'SellwildSDK-RN', :path => '../../../react-native/ios', :modular_headers => true

  target 'SellwildDemoTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
