# Sellwild SDK — Environment Configuration
# Copy to .env.local and fill in real values.

# Dashboard — Athena
ATHENA_DATABASE=your-athena-database-name
ATHENA_OUTPUT_LOCATION=s3://your-bucket/athena-results/

# Dashboard — CloudWatch
PBS_LOG_GROUP=your-cloudwatch-log-group-name

# Dashboard — AWS credentials
SW_AWS_REGION=us-west-1
SW_AWS_ACCESS_KEY_ID=
SW_AWS_SECRET_ACCESS_KEY=

# Docs site deployment
AWS_ACCOUNT_ID=000000000000
CLOUDFRONT_DISTRIBUTION_ID=XXXXXXXXXXXXXX
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:000000000000:certificate/xxxxxxxx
ROUTE53_ZONE_ID=XXXXXXXXXXXXXX
