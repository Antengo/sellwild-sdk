    },
    "severity-critical.json": {
      "instancePath": "/attributes/severity",
      "keyword": "enum"
    },
    "missing-fv.json": {
      "instancePath": "/attributes",
      "keyword": "required"
    },
    "capped-zero.json": {
      "instancePath": "/attributes/capped",
      "keyword": "const"
    },
    "seq-21.json": {
      "instancePath": "/attributes/seq",
      "keyword": "pattern"
    },
    "host-with-path.json": {
      "instancePath": "/attributes/host",
      "keyword": "pattern"
    },
    "label-not-in-enum.json": {
      "instancePath": "/label",
      "keyword": "enum"
    },
    "amount-field.json": {
      "instancePath": "",
