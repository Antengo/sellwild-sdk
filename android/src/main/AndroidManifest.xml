<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Captures the app Context so SellwildSDK.configure() can pre-warm the
             ad stack automatically. Not exported; serves no data. -->
        <provider
            android:name="com.sellwild.sdk.SellwildInitProvider"
            android:authorities="${applicationId}.sellwild-init"
            android:exported="false" />
    </application>

</manifest>
