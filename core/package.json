{
  "name": "@sellwild/sdk-core",
  "version": "1.7.7",
  "description": "Sellwild mobile advertising SDK - core types, API client, and ad configuration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsgo --noEmit -p . && tsgo --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:summary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ../scripts/coverage/ts.mjs --run",
    "test:smoke": "npm run build && node scripts/configure.smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "~3.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.7.3",
    "vitest": "~3.2.7"
  }
}
