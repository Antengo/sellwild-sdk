{
  "name": "@sellwild/react-native-sdk",
  "version": "1.7.7",
  "description": "Sellwild mobile advertising SDK for React Native",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "android/build.gradle",
    "android/src/**/*",
    "ios/*.swift",
    "ios/*.m",
    "ios/*.h",
    "SellwildSDK-RN.podspec"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit -p . && tsgo --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint"
  },
  "keywords": [
    "react-native",
    "advertising",
    "ads",
    "sellwild",
    "marketplace"
  ],
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.70.0"
  },
  "dependencies": {
    "@sellwild/sdk-core": "^1.7.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.0",
    "@types/react-test-renderer": "^18.3.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "~3.2.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.70.1",
    "vitest": "~3.2.7"
  }
}
