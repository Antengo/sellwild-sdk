{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "lib": ["ES2017"],
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "paths": {
      "@sellwild/sdk-core": ["../core/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
