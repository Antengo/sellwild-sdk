{
  "compilerOptions": {
    "target": "ES2017",
    "module": "esnext",
    "lib": ["ES2020"],
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "@sellwild/sdk-core": ["../core/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
